{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Attach by Process ID",
      "processId": "${command:PickProcess}",
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },


    {
      "type": "node",
      "request": "launch",
      "name": "Debug watcherstats_mcp",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "serve",
        "watcherstats_mcp",
        "--inspect=false"
      ],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      },
      "console": "externalTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}