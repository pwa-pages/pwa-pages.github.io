network: binance
api:
  apiKeyHash: '#API_KEY#'
ergo:
  type: node
  initialHeight: #ERGO_HEIGHT#
  mnemonic: "#MNEMONIC#"
  node:
    url: https://node-p2p.ergoplatform.com
binance:
  type: rpc
  rpc:
    url: http://host.docker.internal:8545/
  initial:
    height: #BSC_HEIGHT#
observation:
  confirmation: 300
