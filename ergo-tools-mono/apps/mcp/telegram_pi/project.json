
{
  "name": "telegram_pi",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mcp/telegram_pi/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test apps/mcp/telegram_pi/tests/*.test.mjs"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/mcp/telegram_pi",
        "main": "apps/mcp/telegram_pi/src/main.ts",
        "tsConfig": "apps/mcp/telegram_pi/tsconfig.app.json",
        "assets": [
          {
            "input": "apps/mcp/telegram_pi/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ],
        "generatePackageJson": true,
        "bundle": true,
        "thirdParty": false
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/mcp/telegram_pi/package.json",
        "{workspaceRoot}/dist/apps/mcp/telegram_pi/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/mcp/telegram_pi/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "telegram_pi:build",
        "runBuildTargetDependencies": false,
        "runtimeArgs": [
          "--enable-source-maps",
          "--env-file=apps/mcp/telegram_pi/.env"
        ]
      },
      "configurations": {
        "development": {
          "buildTarget": "telegram_pi:build:development"
        },
        "production": {
          "buildTarget": "telegram_pi:build:production"
        }
      }
    }
  }
}
